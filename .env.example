# GUIVIN Environment Configuration Example
# Copy this file to .env and configure as needed

# Host and port
PORT=8000
HOST=0.0.0.0

# Optional Sentinel Sandbox Integration
# If connecting directly via backend:
SENTINEL_HOST=https://cctv.corp8.cloud
SENTINEL_EMAIL=your_email@example.com
SENTINEL_PASSWORD=your_password_here

# AI Processing
CONFIDENCE_THRESHOLD=0.45
PLATE_CONFIDENCE_THRESHOLD=0.30
DETECTION_INTERVAL=5

# Blockchain Org Identifier
BLOCKCHAIN_ORG=SCRB-Gujarat
BLOCKCHAIN_CHANNEL=evidence-integrity
