# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Database (SQLite — generated at runtime) ──────────────────────────────────
backend/guivin.db
backend/*.db
*.db-journal
*.db-shm
*.db-wal

# ── Evidence frames and clips (large binary, generated at runtime) ─────────────
backend/evidence/frames/*
!backend/evidence/frames/.gitkeep
backend/evidence/clips/*
!backend/evidence/clips/.gitkeep
backend/reports/*
!backend/reports/.gitkeep

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── YOLOv8 / AI model weights (downloaded automatically) ──────────────────────
*.pt
*.onnx
*.torchscript
runs/

# ── EasyOCR model cache ────────────────────────────────────────────────────────
.EasyOCR/
~/.EasyOCR/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
secrets.json
credentials.json

